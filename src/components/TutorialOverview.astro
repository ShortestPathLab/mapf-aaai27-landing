---
import MapfVideo from "./MapfVideo.astro";
---

<div class="overview-cards">
  <div class="intro-row">
    <section class="surface-panel intro-copy bg-transparent">
      <h2 class="mb-5 max-w-xl text-2xl sm:text-3xl">
        How do you move a fleet through shared space without getting in each
        other’s way?
      </h2>
      <div class="prose max-w-prose">
        <p>
          Solve this problem with us. You'll use League of Robot Runners
          Start-Kit and PlanViz to run experiments and leave with a working
          understanding of MAPF and a way to investigate the design decisions
          behind multi-agent coordination.
        </p>
      </div>
    </section>
    <div class="surface-panel intro-media">
      <MapfVideo />
    </div>
  </div>
</div>

<style>
  .overview-cards {
    display: grid;
    gap: var(--bento-gap);
  }
  .overview-cards {
    container-type: inline-size;
  }
  .intro-row {
    display: grid;
    gap: var(--bento-gap);
  }
  .intro-copy {
    padding: var(--hero-content-inset);
  }
  .intro-media {
    padding: 0;
    overflow: hidden;
    min-width: 0;
  }
  @container (min-width: 760px) {
    .intro-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .intro-media {
      position: relative;
    }
    .intro-media :global(.mapf-demo) {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
    }
  }
  .prose > :first-child {
    margin-top: 0;
  }
  .prose > :last-child {
    margin-bottom: 0;
  }
</style>
