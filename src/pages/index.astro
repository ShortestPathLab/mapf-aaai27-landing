---
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "@layouts/Layout.astro";
import Copy from "@components/TutorialOverview.astro";
import HeroMedia from "@components/HeroMedia.astro";
import HeroVideoToggle from "@components/HeroVideoToggle.astro";
import { slugifyStr } from "@utils/slugify";
import { Parallax } from "@components/Card";
---

<Layout>
  <section slot="hero" class="landing-hero" aria-label="Tutorial introduction">
    <div
      id="hero"
      class="relative overflow-hidden"
      transition:name="hero-banner"
      transition:animate="initial"
    >
      <Parallax client:load strength={0.3} className="absolute inset-0 -z-10">
        <HeroMedia />
      </Parallax>
      <HeroVideoToggle />
      <div
        class="hero-kicker mb-24 flex w-full max-w-64 flex-col items-start gap-2 md:max-w-max md:flex-row md:items-center md:gap-4"
      >
        <span
          class="hero-text text-sm font-medium leading-tight"
          transition:name="conference-label"
          transition:animate="initial"
          >Learn MAPF / AAAI 2027 · Montréal, Canada</span
        >
      </div>
      <div class="flex-1"></div>
      <div
        class="flex max-w-[640px] flex-col items-start justify-between gap-4 md:flex-row"
      >
        <div>
          <h1 class="hero-text">Learn Multi-Agent Path Finding at AAAI 2027</h1>
          <p class="hero-text animation-delay-[300ms]" id="tagline">
            A hands-on session for multi-agent pathfinding and its emerging
            trends.
          </p>
        </div>
      </div>

      <div
        class="mt-4 flex items-center justify-center gap-4 *:flex-1 sm:*:min-w-max"
      >
        {
          [
            {
              label: "Where",
              value: "Room TBA, Palais des congrès de Montréal, Canada",
            },
            { label: "When", value: "Time TBA, 16–17 February 2027" },
          ].map(({ label, value }) => (
            <div class="pr-4">
              <h3 class="hero-text text-md mb-1 font-medium">{label}</h3>
              <p class="hero-text text-sm">{value}</p>
            </div>
          ))
        }
      </div>
      <a
        href="/schedule"
        class="hero-cta mt-12 min-w-max rounded-xl bg-skin-accent px-6 py-4 text-sm font-medium text-skin-inverted transition-colors"
      >
        Register now
      </a>
    </div>
  </section>
  <Header slot="header" heroNavigation />
  <main id="main-content" class="enter-fade-vertical">
    <section class="overview-section">
      <div class="landing-overview @container">
        <div class="overview-row flex flex-col @4xl:flex-row">
          <div class="min-w-0 flex-1">
            <Copy />
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  html[data-theme="light"] .hero-image {
    @apply invert;
  }

  .landing-hero {
    --hero-inset: var(--page-inset);
    padding: 0 var(--hero-inset);
  }

  #hero {
    --hero-shade-width: 1100px;
    --hero-shade-height: 110%;
    @apply flex flex-col items-start rounded-2xl bg-cover bg-center;
    position: relative;
    isolation: isolate;
    background-color: #1a1413;
    padding: var(--hero-content-inset);
    min-height: calc(100svh - var(--nav-height) - var(--frame-inset));
  }

  @media (min-width: 920px) {
    #hero .hero-kicker {
      max-width: calc((100% - var(--nav-width, 472px)) / 2 - var(--bento-gap));
      min-height: 36px;
    }
    .landing-hero {
      padding-top: var(--frame-inset);
    }
    #hero {
      min-height: calc(100svh - 2 * var(--frame-inset));
    }
  }

  #hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(
      ellipse var(--hero-shade-width) var(--hero-shade-height) at left bottom,
      rgb(26 20 19 / 82%),
      rgb(26 20 19 / 70%) 40%,
      rgb(26 20 19 / 42%) 70%,
      transparent 100%
    );
  }

  .landing-overview {
    margin-top: 0;
    padding-top: 0;
  }
  .overview-row {
    gap: var(--bento-gap);
  }
  .overview-section,
  .directory-section {
    padding: 0;
  }
  .conference-sidebar {
    width: 100%;
  }
  .conference-heading,
  .registration-card {
    padding: 20px;
  }
  .conference-detail {
    overflow: hidden;
    padding: 0;
  }
  .directory-card {
    padding: 24px;
  }
  @container (min-width: 896px) {
    .conference-sidebar {
      width: 480px;
      flex-shrink: 0;
    }
  }

  #main-content {
    display: grid;
    gap: var(--bento-gap);
  }
  .directory-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--bento-gap);
  }
  @media (max-width: 640px) {
    .directory-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 919px) {
    #hero .hero-kicker {
      display: none;
    }
    #hero {
      --hero-shade-width: 180%;
      --hero-shade-height: 130%;
      margin-top: 0;
      background-position: center;
    }
  }

  #hero h1 {
    @apply inline-block text-balance font-medium tracking-tight;
    font-size: 4rem;
    line-height: 1.05;
  }
  @media (max-width: 640px) {
    #hero h1 {
      font-size: 2.5rem;
    }
  }
  #hero .hero-text {
    color: #ffffff;
  }
  .hero-cta {
    background: rgba(var(--color-accent), 0.9);
    color: rgb(var(--color-text-inverted));
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .hero-cta:hover {
    background: rgba(var(--color-accent), 0.98);
  }
  #hero .rss-link {
    @apply mb-6;
  }
  #hero .rss-icon {
    @apply mb-2 h-6 w-6 scale-110 fill-skin-accent sm:mb-3 sm:scale-125;
  }
  #hero #overline {
    @apply max-w-xl text-sm font-normal opacity-70;
  }
  #hero #tagline {
    @apply mb-2 mt-2 max-w-xl text-balance text-sm font-medium tracking-tight sm:mt-6 sm:text-base;
  }

  /* ===== Featured & Recent Posts Sections ===== */
</style>
